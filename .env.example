# Postgres. Absent means the dashboard reads the committed fixture set, which
# is what makes it runnable without a server.
DATABASE_URL=postgres://reno:password@localhost:5432/reno

# Who may write records. One entry per site: <site_id>:<token>, comma separated.
# The site prefix is what scopes a token — a token cannot write into a site it
# does not serve. Generate with: openssl rand -hex 24
INGEST_TOKENS=lwas:replace-me-with-a-real-token

# Sign-in needs a database: there is no mode in which the Reno surface serves
# without a session. For a local run without Postgres installed:
#   DATABASE_URL=pglite://./.pglite
# then: pnpm user:add you@renno.co.id "Your Name"
