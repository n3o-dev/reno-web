{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y",
    "typescript",
    "oxc"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "react/react-in-jsx-scope": "off",
    "oxc/no-map-spread": "off"
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "prototype",
    "contract",
    "fixtures"
  ]
}
