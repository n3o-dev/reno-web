{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "nextjs",
    "jsx-a11y",
    "typescript",
    "oxc"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "react/react-in-jsx-scope": "off",
    "oxc/no-map-spread": "off"
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "prototype",
    "contract",
    "fixtures",
    "scripts/vendor"
  ],
  "overrides": [
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/db/**",
        "tests/ingest/**",
        "scripts/seed-e2e.ts",
        "scripts/seed-demo.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
