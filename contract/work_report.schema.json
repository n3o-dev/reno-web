{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "source_message_id": {
      "type": "string",
      "minLength": 1
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sender_raw": {
      "type": "string",
      "minLength": 1
    },
    "sender_person_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "area_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "job_text": {
      "type": "string"
    },
    "photo_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "is_before_after": {
      "type": "boolean"
    },
    "shift": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "no_area",
          "no_caption",
          "done_without_complaint",
          "photo_reused",
          "photo_late_1h",
          "photo_late_3h",
          "photo_before_complaint"
        ]
      }
    }
  },
  "required": [
    "record_id",
    "site_id",
    "source_message_id",
    "sent_at",
    "sender_raw",
    "sender_person_id",
    "confidence",
    "area_id",
    "job_text",
    "photo_ids",
    "is_before_after",
    "shift",
    "defects"
  ],
  "additionalProperties": false
}
